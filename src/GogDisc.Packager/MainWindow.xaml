<Window x:Class="GogDisc.Packager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOG Disc Packager" Width="1050" Height="940" MinWidth="900" MinHeight="640"
        Background="#11151D" Foreground="White" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="GOG DISC PACKAGER" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Create trustworthy physical releases from stock GOG setup files."
                       Foreground="#AEB7C7" Margin="0,5,0,18"/>
        </StackPanel>

        <!-- The whole form scrolls as one region; summary, log and actions stay pinned below. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Deployment type" Width="165" VerticalAlignment="Center"/>
                <ComboBox x:Name="DeploymentTypeBox" Width="280" SelectedIndex="0" SelectionChanged="DeploymentTypeBox_SelectionChanged">
                    <ComboBoxItem Content="Standard Game Backup (single game on one or more discs)"/>
                    <ComboBoxItem Content="Game Collection Backup (multiple games on a single disc)"/>
                    <ComboBoxItem Content="Game-Key Disc (download online GOG backup)"/>
                </ComboBox>
            </StackPanel>
            <Grid x:Name="KeyAccountPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="GOG account" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="AccountStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="#8F99AA" Margin="0,4"/>
                <Button Grid.Column="2" x:Name="AccountSignInButton" Content="Sign in to GOG…" Click="SignInGog_Click"/>
            </Grid>

            <Grid x:Name="KeyIdentityPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="280"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Game title or GOG URL" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="GameLookupBox" TextChanged="GameLookupBox_TextChanged"/>
                <Button Grid.Column="3" Content="Find game" Click="FindGame_Click"/>
                <TextBlock Grid.Row="1" Text="Matched GOG product" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ResolvedGameBox" SelectionChanged="ResolvedGameBox_SelectionChanged"/>
                <TextBlock Grid.Row="2" Text="Language" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="LanguageBox" Text="en"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="12,4,0,0" Foreground="#8F99AA" Text="Searches the games your GOG account owns; no credentials are written to media."/>
            </Grid>

            <Grid x:Name="KeyDlcPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Add-ons you own" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <StackPanel Grid.Column="1">
                    <ItemsControl x:Name="DlcList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,4">
                                    <CheckBox Content="{Binding Title}" IsChecked="{Binding Selected, Mode=TwoWay}"
                                              Foreground="#C9D0DB" Margin="2,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="20,3,0,0" Visibility="{Binding ArtVisibility}">
                                        <Button Content="Disc art…" Padding="8,2" Click="BrowseDlcArt_Click" Tag="{Binding}"/>
                                        <TextBlock Text="{Binding ArtSummary}" Foreground="#8F99AA" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="DlcHint" Foreground="#8F99AA" TextWrapping="Wrap" Margin="2,2,0,0"
                               Text="Select a game to list the add-ons your account owns."/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Disc layout" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                    <RadioButton x:Name="SingleDiscOption" GroupName="KeyLayout" IsChecked="True" Foreground="#C9D0DB"
                                 Content="Everything on one disc" Checked="KeyLayout_Changed"/>
                    <RadioButton x:Name="MultiDiscOption" GroupName="KeyLayout" Foreground="#C9D0DB" Margin="0,3,0,0"
                                 Content="One disc per product (Disc 1 base game, then one per add-on)" Checked="KeyLayout_Changed"/>
                    <TextBlock x:Name="KeyLayoutHint" Foreground="#8F99AA" TextWrapping="Wrap" Margin="2,3,0,0"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="SetupLabel" Grid.Row="0" Text="GOG setup" VerticalAlignment="Top" Margin="0,8,0,0"/>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBox x:Name="SetupBox"/>
                    <TextBlock x:Name="CollectionFolderHint" Visibility="Collapsed" Margin="2,5,0,6"
                               Foreground="#8F99AA" TextWrapping="Wrap"
                               Text="Recommended layout: Collection\Game Name\Base Game\setup_*.exe (+ .bin files), with optional extras in Collection\Game Name\Extras\."/>
                </StackPanel>
                <Button x:Name="SetupBrowseButton" Grid.Row="0" Grid.Column="2" Content="Browse…" Click="BrowseSetup_Click"/>

                <TextBlock Grid.Row="1" Text="Title" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TitleBox"/>

                <TextBlock Grid.Row="2" Text="Version" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="VersionBox"/>

                <TextBlock x:Name="ProductTypeLabel" Grid.Row="3" Text="Product type" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ProductTypeBox" SelectedIndex="0">
                    <ComboBoxItem Content="Base game"/><ComboBoxItem Content="DLC"/>
                </ComboBox>

                <TextBlock x:Name="MediaLabel" Grid.Row="4" Text="Media" VerticalAlignment="Top" Margin="0,8,0,0"/>
                <StackPanel x:Name="MediaPanel" Grid.Row="4" Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="MediaBox" Width="280" SelectedIndex="5" SelectionChanged="MediaBox_SelectionChanged">
                            <ComboBoxItem Content="CD-R 74 min (650 MB)"/>
                            <ComboBoxItem Content="CD-R 80 min (700 MB)"/>
                            <ComboBoxItem Content="DVD-5, single layer (4.7 GB)"/>
                            <ComboBoxItem Content="DVD-9, dual layer (8.5 GB)"/>
                            <ComboBoxItem Content="BD-25 (25 GB)"/>
                            <ComboBoxItem Content="BD-50 (50 GB)"/>
                            <ComboBoxItem Content="BDXL-100 (100 GB)"/>
                            <ComboBoxItem Content="BDXL-128 (128 GB)"/>
                            <ComboBoxItem Content="Mixed media - optimize inventory"/>
                            <ComboBoxItem Content="Custom capacity"/>
                        </ComboBox>
                        <TextBox x:Name="CustomCapacityBox" Width="100" Text="50" Margin="10,4,0,4" Visibility="Collapsed"/>
                        <TextBlock x:Name="CustomCapacityLabel" Text="GB" Margin="7,0" VerticalAlignment="Center"
                                   Foreground="#AEB7C7" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel x:Name="MixedMediaPanel" Visibility="Collapsed" Margin="0,7,0,6">
                        <TextBlock Text="Available blank discs" Foreground="#C9D0DB"/>
                        <TextBox x:Name="MediaInventoryBox" Text="BD50 x1, BD25 x10" TextChanged="MediaInventoryBox_TextChanged"/>
                        <TextBlock Margin="2,3,0,0" Foreground="#8F99AA" TextWrapping="Wrap"
                                   Text="Example: BD50 x1, BD25 x10. Also accepts CD650, CD700, DVD5, DVD9, BD100, and BD128."/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="ExtrasLabel" Grid.Row="5" Text="Extras folder" VerticalAlignment="Center"/>
                <StackPanel x:Name="ExtrasPanel" Grid.Row="5" Grid.Column="1">
                    <TextBox x:Name="ExtrasBox"/>
                    <CheckBox x:Name="IncludePatchesBox" Content="Preserve patch_* files as non-running archival extras"
                              Foreground="#C9D0DB" Margin="2,3,0,6"/>
                </StackPanel>
                <Button x:Name="ExtrasBrowseButton" Grid.Row="5" Grid.Column="2" Content="Browse…" Click="BrowseExtras_Click"/>

                <TextBlock Grid.Row="6" Text="Background" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="BackgroundBox"/>
                <Button Grid.Row="6" Grid.Column="2" Content="Browse…" Click="BrowseBackground_Click"/>

                <TextBlock Grid.Row="7" Text="Cover art" VerticalAlignment="Center"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="CoverBox"/>
                <Button Grid.Row="7" Grid.Column="2" Content="Browse…" Click="BrowseCover_Click"/>

                <TextBlock Grid.Row="8" Text="Disc icon" VerticalAlignment="Center"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="IconBox"/>
                <Button Grid.Row="8" Grid.Column="2" Content="Browse…" Click="BrowseIcon_Click"/>

                <TextBlock Grid.Row="9" Text="Output folder" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="9" Grid.Column="1">
                    <TextBox x:Name="OutputBox"/>
                    <CheckBox x:Name="OpenWhenCompleteBox" Content="Open package folder when complete"
                              IsChecked="True" Foreground="#C9D0DB" Margin="2,3,0,6"/>
                    <CheckBox x:Name="ResetAfterBuildBox" Content="Clear backup inputs after build (keep output folder)"
                              Foreground="#C9D0DB" Margin="2,0,0,6"/>
                </StackPanel>
                <Button Grid.Row="9" Grid.Column="2" Content="Browse…" Click="BrowseOutput_Click"/>

                <TextBlock Grid.Row="10" Text="Launcher EXE" VerticalAlignment="Center"/>
                <TextBox Grid.Row="10" Grid.Column="1" x:Name="LauncherBox"/>
                <Button Grid.Row="10" Grid.Column="2" Content="Browse…" Click="BrowseLauncher_Click"/>

            </Grid>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#181E29" BorderBrush="#323C4E" BorderThickness="1"
                CornerRadius="5" Padding="14" Margin="0,14,0,8">
            <TextBlock x:Name="SummaryText" Text="Select a stock setup_*.exe, then scan the package." TextWrapping="Wrap" Foreground="#D4D9E2"/>
        </Border>

        <Grid Grid.Row="3" x:Name="ActivityPanel" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="LogBox" Height="88" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/>
            <ProgressBar Grid.Row="1" x:Name="BuildProgress" Height="16" Margin="0,12,0,0"
                         Minimum="0" Maximum="100" Foreground="#E75C2A" Background="#323C4E"/>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#AEB7C7" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Background="#465065"/>
                <Button x:Name="ScanButton" Content="Scan package" Click="Scan_Click" Background="#465065"/>
                <Button x:Name="BuildButton" Content="Build disc folders" Click="Build_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
