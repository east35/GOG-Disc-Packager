<Window x:Class="GogDisc.Packager.DiscPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a disc layout" Width="650" SizeToContent="Height" MaxHeight="620"
        Background="#11151D" Foreground="White" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Which layout fits your case?" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Margin="0,6,0,14" Foreground="#AEB7C7" TextWrapping="Wrap"
                   Text="Choose the sweet spot for the case you have. Fewer discs mean fewer burns; larger layouts can preserve higher-capacity blanks. Each option fits the package and safety reserve."/>
        <ListBox x:Name="OptionsList" MinHeight="70" MaxHeight="330" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 DisplayMemberPath="ChoiceLabel" SelectedIndex="0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Use this layout" Width="125" IsDefault="True" Click="Accept_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
