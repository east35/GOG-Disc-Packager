<Window x:Class="GogDisc.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="529" Height="724" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Foreground="#111111"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Border Background="White" CornerRadius="14" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.32"/>
        </Border.Effect>
        <Border.Clip>
            <RectangleGeometry x:Name="WindowClip" Rect="0,0,505,700" RadiusX="14" RadiusY="14"/>
        </Border.Clip>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="294"/>
                <RowDefinition x:Name="ContentRow" Height="303"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="102"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Hero" MouseLeftButtonDown="Hero_MouseLeftButtonDown">
                <Image x:Name="BackgroundImage" Stretch="UniformToFill" VerticalAlignment="Top" Height="294"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#18000000" Offset="0"/>
                            <GradientStop Color="#10FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#F4FFFFFF" Offset="0.84"/>
                            <GradientStop Color="#FFFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Button Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,7,8,0" Style="{StaticResource SecondaryButton}" Padding="0" Click="Close_Click">
                    <Path Width="14" Height="14" Data="M 1,1 L 13,13 M 13,1 L 1,13"
                          Stroke="#171717" StrokeThickness="1.6" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Stretch="None"/>
                </Button>

                <Button x:Name="EjectButton" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,7,50,0" Style="{StaticResource SecondaryButton}" Padding="0" Click="Eject_Click"
                        ToolTip="Eject disc">
                    <Grid Width="16" Height="16">
                        <Path Data="M 2,10 L 8,3 L 14,10 Z" Stroke="#171717" Fill="Transparent"
                              StrokeThickness="1.5" StrokeLineJoin="Round"/>
                        <Path Data="M 2,13 L 14,13" Stroke="#171717" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </Button>

                <Border Width="152" Height="211" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="24,80,0,0" CornerRadius="9" Background="#ECECEC">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="17" ShadowDepth="7" Opacity="0.26"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock x:Name="CoverPlaceholder" Text="COVER ART" Foreground="#888888"
                                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image x:Name="CoverImage" Width="152" Height="211" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,152,211" RadiusX="9" RadiusY="9"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel Margin="192,204,20,0" VerticalAlignment="Top">
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxHeight="62"/>
                    <TextBlock x:Name="SizeText" FontSize="14" Foreground="#6C6C6C" Margin="0,2,0,0"/>
                    <TextBlock x:Name="RequiredSpaceText" FontSize="14" Foreground="#6C6C6C" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="24,18">
                <Grid x:Name="DefaultPanel">
                    <StackPanel>
                    <TextBlock Text="We’ll install this game to a new folder in this location:" FontSize="14"/>
                    <Border Height="72" Margin="0,8,0,16" BorderBrush="#D3D3D3" BorderThickness="1" CornerRadius="8" Background="White">
                        <Grid Margin="16,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DestinationText" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="FreeSpaceText" FontSize="14" Foreground="#6C6C6C" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Width="36" Height="36" Style="{StaticResource LinkButton}"
                                    Click="ChooseInstallLocation_Click" ToolTip="Choose installation location">
                                <Path Data="M 1,2 L 7,8 L 13,2" Stroke="#171717" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="TemporaryLocationSection">
                        <TextBlock Text="Temporary GOG disc backup location:" FontSize="14"/>
                        <Border Height="72" Margin="0,8,0,8" BorderBrush="#D3D3D3" BorderThickness="1"
                                CornerRadius="8" Background="White">
                            <Grid Margin="16,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TemporaryLocationText" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TemporaryFreeSpaceText" FontSize="14" Foreground="#6C6C6C" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Width="36" Height="36" Style="{StaticResource LinkButton}"
                                        Click="ChooseTemporaryLocation_Click" ToolTip="Choose temporary backup location">
                                    <Path Data="M 1,2 L 7,8 L 13,2" Stroke="#171717" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock Text="Disc installation files are combined here for the original GOG installer. This backup is removed after installation completes."
                                   FontSize="12" Foreground="#8A8A8A" TextWrapping="Wrap"/>
                    </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="InstalledPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Current installation:" FontSize="14"/>
                    <Border Grid.Row="2" BorderBrush="#D3D3D3" BorderThickness="1" CornerRadius="8" Background="White">
                        <Grid Margin="16,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="InstalledLocationText" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="InstalledFreeSpaceText" FontSize="14" Foreground="#6C6C6C" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="UninstallButton" Grid.Column="1" Content="Uninstall"
                                    Style="{StaticResource LinkButton}" Click="Uninstall_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="EstimateText" Text="Estimated time remaining: Calculating…" FontSize="14"/>
                    <Border Grid.Row="2" BorderBrush="#D3D3D3" BorderThickness="1" CornerRadius="8" Background="White" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="8"/></Grid.RowDefinitions>
                            <Grid x:Name="DiscLabelsGrid"/>
                            <ProgressBar Grid.Row="2" x:Name="CopyProgress" Minimum="0" Maximum="100"
                                         Style="{StaticResource DiscProgress}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#D5D5D5"/>

            <Grid Grid.Row="3" Background="#F5F5F5">
                <Grid Margin="24,24,24,28">
                <Grid x:Name="DefaultActions">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryButton}"
                            Click="Install_Click"/>
                    <Button x:Name="PreInstallExtrasButton" Grid.Column="2" Content="Extras"
                            Style="{StaticResource SecondaryButton}" Click="Extras_Click"/>
                </Grid>

                <Grid x:Name="InstalledActions" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Content="Play" Style="{StaticResource PrimaryButton}" Click="Play_Click"/>
                    <Button x:Name="ExtrasButton" Grid.Column="2" Content="Extras" Style="{StaticResource SecondaryButton}"
                            Click="Extras_Click"/>
                </Grid>

                <Grid x:Name="OperationActions" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                    <Button x:Name="OperationStatusButton" Content="Installing…" IsHitTestVisible="False"
                            Focusable="False" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>
                </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
